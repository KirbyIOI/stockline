PORT=4000

# First-run admin credentials — after the very first start, accounts are managed
# from Settings → Team inside the app, and these variables are no longer read.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Used to sign JSON Web Tokens for session management.
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Optional: when the frontend is hosted separately (not served by Express), set
# this to the exact origin so CORS allows the browser to connect, e.g.
# CLIENT_ORIGIN=https://stockline-frontend.netlify.app
# CLIENT_ORIGIN=

# Optional: when running in production with a persistent disk mount (e.g. Render
# option B), point the database path at the mounted volume:
# DB_PATH=/opt/render/project/src/server/data/inventory.db
# DB_PATH=

# --- AI Assistant (optional) ---
# Get a Gemini API key at https://aistudio.google.com/apikey
# Once set, restart the server — a sparkle button appears in the app.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
